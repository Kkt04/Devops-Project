{
  "name": "artisan-hub-server",
  "version": "1.0.0",
  "description": "Backend for ArtisanHub marketplace",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --runInBand --forceExit",
    "test:coverage": "jest --coverage --forceExit",
    "lint": "eslint src/ --ext .js",
    "prisma:generate": "dotenv -e .env -- prisma generate",
    "prisma:push": "dotenv -e .env -- prisma db push",
    "seed": "node src/prisma/seed.js",
    "setup": "npm run prisma:generate && npm run prisma:push && npm run seed"
  },
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "dotenv-cli": "^7.4.2",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prisma": "^5.7.0",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"],
    "coverageDirectory": "coverage"
  }
}